# Environment variables for E2E tests
# Copy to .maestro.env or set in your shell before running

EXPO_PUBLIC_API_URL=http://localhost:8000

# Test user credentials
E2E_USER_DOCUMENTO=12345678
E2E_USER_PASSWORD=password123

# Non-approved user
E2E_NOAPROBADO_DOCUMENTO=99999991
E2E_NOAPROBADO_PASSWORD=password123

# Blocked user
E2E_BLOQUEADO_DOCUMENTO=99999992
E2E_BLOQUEADO_PASSWORD=password123

# Admin credentials (already exists in Supabase, DO NOT seed)
E2E_ADMIN_DOCUMENTO=00000003
E2E_ADMIN_PASSWORD=12345678

# Auction IDs (created by seed-e2e.sql)
E2E_SUBASTA_ID_ABIERTA=800010
E2E_SUBASTA_ID_EN_VIVO=800011
E2E_SUBASTA_ID_FINALIZADA=800012
